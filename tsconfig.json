{
   "compilerOptions": {
      "target": "ES2020",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "rootDir": "./src",
      "outDir": "./lib",
      "types": ["node", "vitest/globals"],
      "strict": false,
      "skipLibCheck": true
   },
   "include": ["src"],
   "exclude": ["node_modules"]
}
